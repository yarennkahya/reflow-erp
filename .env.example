# OpenAI (AI karar destek katmanı için)
OPENAI_API_KEY=sk-...

# Sentry (opsiyonel — hata izleme)
SENTRY_DSN=

# E-posta (opsiyonel)
EMAIL_HOST_USER=your-email@example.com
